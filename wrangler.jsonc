{
  "name": "sahmoo-tattoos",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sahmoo-bookings-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sahmoo-proofs-local"
    }
  ],
  "vars": {
    "ADMIN_EMAILS": "anotida174@icloud.com",
    "BOOKING_START_DATE": "2026-10-15",
    "BOOKING_END_DATE": "2026-12-30"
  }
}
